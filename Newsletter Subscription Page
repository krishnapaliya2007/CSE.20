<!DOCTYPE html>
<html>
<head>
  <title>Newsletter</title>
  <style>
    body {
      font-family: Arial;
      background: #667eea;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    .box {
      background: rgba(0,0,0,0.2);
      padding: 30px;
      border-radius: 10px;
      text-align: center;
    }
    input {
      padding: 10px;
      width: 250px;
      margin-top: 10px;
    }
    button {
      margin-top: 10px;
      padding: 10px;
      width: 100%;
      border: none;
      background: white;
      color: #333;
    }
  </style>
</head>
<body>

<div class="box">
  <h2>Subscribe to Newsletter</h2>
  <input type="email" placeholder="Enter your email">
  <button>Subscribe</button>
</div>

</body>
</html>
