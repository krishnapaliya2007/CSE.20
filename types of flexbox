<!DOCTYPE html>
<html>
<head>
  <title>Flexbox Practice - All Types</title>

  <style>
    body {
      font-family: Arial;
      background: whitesmoke;
      margin: 0;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: darkblue;
    }

    h2 {
      color: navy;
      margin-top: 30px;
    }

    /* common box style */
    .box {
      background: steelblue;
      color: white;
      padding: 15px;
      text-align: center;
      min-width: 80px;
    }

    /* common container style */
    .container {
      background: lightgray;
      padding: 15px;
      margin-top: 10px;
      margin-bottom: 20px;
    }

    /* section 1 */
    .row {
      display: flex;
      flex-direction: row;
      gap: 10px;
    }

    /* section 2 */
    .column {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 150px;
    }

    /* section 3 */
    .center {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 150px;
    }

    /* section 4 */
    .space {
      display: flex;
      justify-content: space-between;
    }

    /* section 5 */
    .wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    /* section 6 */
    .grow .one {
      flex-grow: 1;
      background: skyblue;
    }

    .grow .two {
      flex-grow: 2;
      background: lightgreen;
    }

    /* section 7 */
    .align {
      display: flex;
      align-items: flex-start;
      height: 120px;
    }

    /* section 8 */
    .order .first {
      order: 2;
      background: tomato;
    }

    .order .second {
      order: 1;
      background: orange;
    }

    /* section 9 */
    .shrink .small {
      flex-shrink: 0;
      background: purple;
    }

    .shrink .big {
      width: 200px;
      background: pink;
    }
  </style>
</head>

<body>

<h1>Flexbox Practice (All Types)</h1>

<h2>1. Flex Direction (Row)</h2>
<div class="container row">
  <div class="box">Box 1</div>
  <div class="box">Box 2</div>
  <div class="box">Box 3</div>
</div>

<h2>2. Flex Direction (Column)</h2>
<div class="container column">
  <div class="box">A</div>
  <div class="box">B</div>
  <div class="box">C</div>
</div>

<h2>3. Centering (justify + align)</h2>
<div class="container center">
  <div class="box">Center</div>
</div>

<h2>4. Justify Content (Space Between)</h2>
<div class="container space">
  <div class="box">Left</div>
  <div class="box">Right</div>
</div>

<h2>5. Flex Wrap</h2>
<div class="container wrap">
  <div class="box">One</div>
  <div class="box">Two</div>
  <div class="box">Three</div>
  <div class="box">Four</div>
  <div class="box">Five</div>
</div>

<h2>6. Flex Grow</h2>
<div class="container grow">
  <div class="box one">Grow 1</div>
  <div class="box two">Grow 2</div>
</div>

<h2>7. Align Items</h2>
<div class="container align">
  <div class="box">Top</div>
  <div class="box">Top</div>
</div>

<h2>8. Order Property</h2>
<div class="container order">
  <div class="box first">Second</div>
  <div class="box second">First</div>
</div>

<h2>9. Flex Shrink</h2>
<div class="container shrink">
  <div class="box big">Big</div>
  <div class="box small">No Shrink</div>
</div>

</body>
</html>
